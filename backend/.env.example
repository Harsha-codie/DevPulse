# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# ===========================================
# GEMINI AI API KEY (REQUIRED)
# ===========================================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ===========================================
# JWT AUTHENTICATION SECRET (REQUIRED)
# ===========================================
# Use a strong random string (minimum 256 bits)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_min_256_bits_change_this

# ===========================================
# OPENWEATHER API KEY (OPTIONAL)
# ===========================================
# Get your API key from: https://openweathermap.org/api
# If not provided, weather features will be limited
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ===========================================
# DATABASE CONFIGURATION (H2 In-Memory)
# ===========================================
# No additional config needed - H2 runs in-memory by default
# To use persistent H2:
# spring.datasource.url=jdbc:h2:file:./data/cropplanner

# ===========================================
# SERVER CONFIGURATION (DEFAULT VALUES)
# ===========================================
# Uncomment to override defaults:
# SERVER_PORT=8080
# SPRING_PROFILES_ACTIVE=dev

# ===========================================
# CORS CONFIGURATION (DEFAULT VALUES)
# ===========================================
# Frontend URL for CORS (default: http://localhost:5173)
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# ===========================================
# LOGGING (DEFAULT VALUES)
# ===========================================
# Uncomment to enable debug logging:
# LOGGING_LEVEL_ROOT=INFO
# LOGGING_LEVEL_AI_CROPPLANNER=DEBUG
